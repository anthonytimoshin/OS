[Unit]
Description=File Opener D-Bus Service
After=dbus.service
Requires=dbus.service

[Service]
Type=simple
ExecStart=/home/administrator/lab6/unit
Restart=always
RestartSec=5
User=administrator
Environment="DISPLAY=:0"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
WorkingDirectory=/home/administrator/lab6/

[Install]
WantedBy=default.target
